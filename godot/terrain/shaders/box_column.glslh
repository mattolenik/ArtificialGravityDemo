// The column rule of the tunnels design, shared by box_unpack.glsl and box_pack.glsl (VoxelColumn is the CPU
// reference and the tests): a window column (the 27 fields at one texel) is solid runs separated by up to four
// gaps; a box column is K voxels of 1 m from height index k0 up, each a solid and a loose fraction in
// 0..ONE. Included after the shader's image declarations (w_* at the same names) and its push constants.
// Per-invocation globals hold one column's voxels: the includer fills or reads them. flg bit 0 (the voxel
// word's top byte) marks a partial whose solid hangs from the voxel's ceiling (a run's underside): the pack and
// the scoop place such a partial at the top, any other on its floor when solid lies under it.

const int TILE = 128;
const float ONE = 65535.0;
const float BELOW = -1.0e9;
const int K = 64;
const int COLUMNS = 256;
const int SLOTS = 1024;
const int VOXELS_PER_BRICK = 4096;

uint sol[K];
uint loo[K];
uint mat[K];
uint cmp[K];
uint flg[K];

// Floor modulo; GLSL's % is undefined for negative operands.
int wrap(int a, int n) {
	return a - n * int(floor(float(a) / float(n)));
}

uint byte(float unorm) {
	return uint(round(unorm * 255.0));
}

// Half up, as GDScript's roundi for positives (round() is implementation-defined at .5).
float roundh(float x) {
	return floor(x + 0.5);
}

// Texel t of cell c (theta wrapped), false if its tile is not in the window (edit.glsl's residency test).
bool texel(ivec2 c, out ivec2 t) {
	int ty = c.y / TILE - pc.first_tile.y;
	int d = c.x - pc.first_tile.x * TILE;
	d += d < 0 ? pc.n_theta : 0;
	if (c.y < 0 || ty < 0 || ty >= pc.slots || d >= pc.slots * TILE) {
		return false;
	}
	t = (c / TILE % pc.slots) * TILE + c % TILE;
	return true;
}

// The index of brick slot s (16 x 16 x 4).
int slot_index(ivec3 s) {
	return (s.z * 16 + s.y) * 16 + s.x;
}

// The world cell of box column slot s (0..255 each) under origin o (bricks; o.x may be unwrapped), theta
// wrapped; ok false when the row is off the station.
ivec2 cell_of_slot(ivec2 s, ivec3 o, out bool ok) {
	ivec2 b = o.xy + ivec2(wrap(s.x / 16 - o.x, 16), wrap(s.y / 16 - o.y, 16));
	ivec2 c = b * 16 + s % 16;
	c.x = wrap(c.x, pc.n_theta);
	ok = c.y >= 0 && c.y < pc.n_z;
	return c;
}

// The box column slot of world cell c (c.x wrapped, c.y on the station); ok false outside the box under o.
ivec2 slot_of_cell(ivec2 c, ivec3 o, out bool ok) {
	ivec2 b = c / 16;
	ok = wrap(b.x - o.x, pc.around) < 16 && b.y >= o.y && b.y < o.y + 16;
	return (b % 16) * 16 + c % 16;
}

struct Col {
	float s, bt, cb, ct, loose;
	int mat, comp, sat;
	float gb[4], gt[4], gl[4];
};

Col read_col(ivec2 t) {
	Col c;
	c.s = imageLoad(w_surface, t).r;
	c.bt = imageLoad(w_bedrock, t).r;
	c.cb = imageLoad(w_clay_bottom, t).r;
	c.ct = imageLoad(w_clay_top, t).r;
	c.loose = imageLoad(w_loose, t).r;
	c.mat = int(byte(imageLoad(w_material, t).r));
	c.comp = int(byte(imageLoad(w_compaction, t).r));
	c.sat = int(byte(imageLoad(w_saturation, t).r));
	c.gb[0] = imageLoad(w_gap_bottom0, t).r;
	c.gb[1] = imageLoad(w_gap_bottom1, t).r;
	c.gb[2] = imageLoad(w_gap_bottom2, t).r;
	c.gb[3] = imageLoad(w_gap_bottom3, t).r;
	c.gt[0] = imageLoad(w_gap_top0, t).r;
	c.gt[1] = imageLoad(w_gap_top1, t).r;
	c.gt[2] = imageLoad(w_gap_top2, t).r;
	c.gt[3] = imageLoad(w_gap_top3, t).r;
	c.gl[0] = imageLoad(w_gap_loose0, t).r;
	c.gl[1] = imageLoad(w_gap_loose1, t).r;
	c.gl[2] = imageLoad(w_gap_loose2, t).r;
	c.gl[3] = imageLoad(w_gap_loose3, t).r;
	return c;
}

// Rock up to bedrock_top, clay through the lens, dirt elsewhere (VoxelColumn.material_at).
int material_at(float h, Col c) {
	if (h <= c.bt) {
		return 2;
	}
	return (h >= c.cb && h <= c.ct) ? 1 : 0;
}

// The solid runs of a column, top-down: top, bottom (the last BELOW), the loose on the top in m and its
// compaction (VoxelColumn.runs_of).
struct Runs {
	float t[5], b[5], l[5];
	int c[5];
	int n;
};

Runs runs_of(Col c) {
	float gt[4], gb[4], gl[4];
	int ng = 0;
	for (int g = 0; g < 4; g++) {
		if (c.gt[g] > c.gb[g]) {
			int i = ng;
			while (i > 0 && gt[i - 1] < c.gt[g]) {
				gt[i] = gt[i - 1];
				gb[i] = gb[i - 1];
				gl[i] = gl[i - 1];
				i--;
			}
			gt[i] = c.gt[g];
			gb[i] = c.gb[g];
			gl[i] = c.gl[g];
			ng++;
		}
	}
	Runs r;
	r.n = 0;
	float top = c.s;
	float lm = c.loose;
	int cm = c.comp;
	for (int g = 0; g < ng; g++) {
		if (gt[g] < top) {
			r.t[r.n] = top;
			r.b[r.n] = gt[g];
			r.l[r.n] = lm;
			r.c[r.n] = cm;
			r.n++;
		}
		if (gb[g] < top) {
			top = gb[g];
			lm = gl[g];
			cm = 0;
		}
	}
	r.t[r.n] = top;
	r.b[r.n] = BELOW;
	r.l[r.n] = lm;
	r.c[r.n] = cm;
	r.n++;
	return r;
}

void clear_column() {
	for (int i = 0; i < K; i++) {
		sol[i] = 0u;
		loo[i] = 0u;
		mat[i] = 0u;
		cmp[i] = 0u;
		flg[i] = 0u;
	}
}

// VoxelColumn.unpack: the column's voxels from k0 into the globals. A voxel's solid is its overlap with the
// runs; each run's loose (m over (R - floor)) fills the voxels from the floor up by their annuli (R - k - 0.5);
// a run topping under the range keeps its loose stored, loose past the range's top is dropped.
void column_voxels(Col c, int k0) {
	clear_column();
	Runs r = runs_of(c);
	for (int j = 0; j < r.n; j++) {
		float lo = max(r.b[j], float(k0));
		float hi = min(r.t[j], float(k0 + K));
		for (int k = int(floor(lo)); k < int(ceil(hi)); k++) {
			float m = min(hi, float(k + 1)) - max(lo, float(k));
			if (m <= 0.0) {
				continue;
			}
			int i = k - k0;
			if (sol[i] == 0u) {
				mat[i] = uint(material_at(min(hi, float(k + 1)) - 0.01, c));
				// A run's bottom inside the voxel, reaching its ceiling: the piece hangs.
				flg[i] = (lo > float(k) && hi >= float(k + 1)) ? 1u : 0u;
			} else {
				flg[i] = 0u;
			}
			sol[i] = min(sol[i] + uint(roundh(m * ONE)), uint(ONE));
		}
	}
	for (int j = 0; j < r.n; j++) {
		if (r.l[j] <= 0.0 || r.t[j] < float(k0)) {
			continue;
		}
		float v = r.l[j] * (pc.R - r.t[j]);
		int k = int(floor(r.t[j]));
		while (v > 0.0 && k < k0 + K) {
			int i = k - k0;
			int room = int(ONE) - int(sol[i]) - int(loo[i]);
			if (room > 0) {
				int q = min(int(roundh(v / (pc.R - float(k) - 0.5) * ONE)), room);
				if (q == 0) {
					break;
				}
				loo[i] += uint(q);
				cmp[i] = uint(r.c[j]);
				v -= float(q) / ONE * (pc.R - float(k) - 0.5);
			}
			k++;
		}
	}
}
