; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Artificial Gravity"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

GodotAIBridgeRuntime="*res://addons/godot_ai_bridge/runtime_bridge.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_ai_bridge/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"
3d/default_gravity=0.0
3d/default_linear_damp=0.0
3d/default_angular_damp=0.0

[shader_globals]

light_bar_theta={
"type": "float",
"value": 0.0
}
light_bar_edge={
"type": "vec2",
"value": Vector2(-0.342, 0.6428)
}
